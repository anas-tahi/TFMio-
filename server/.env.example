# ── Server ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MongoDB Atlas ──
# Replace <db_password> with your real password. Never commit the filled-in .env.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/tfmio?appName=Cluster0

# ── JWT ──
# Use a long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── OpenAI ──
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
